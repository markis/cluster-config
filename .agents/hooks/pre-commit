#!/bin/sh
set -e

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FAILED=0

# Check if yamllint is available
if command -v yamllint >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running yamllint..."
  YAML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ya?ml)$' || true)
  if [ -n "$YAML_FILES" ]; then
    if ! yamllint $YAML_FILES; then
      echo "${RED}✗ yamllint failed${NC}"
      FAILED=1
    fi
  else
    echo "  No YAML files to check"
  fi
else
  echo "${YELLOW}⚠ yamllint not found, skipping...${NC}"
  echo "  Install with: pip install yamllint"
fi

# Check if markdownlint is available
if command -v markdownlint >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running markdownlint..."
  MD_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
  if [ -n "$MD_FILES" ]; then
    if ! markdownlint $MD_FILES; then
      echo "${RED}✗ markdownlint failed${NC}"
      FAILED=1
    fi
  else
    echo "  No Markdown files to check"
  fi
else
  echo "${YELLOW}⚠ markdownlint not found, skipping...${NC}"
  echo "  Install with: npm install -g markdownlint-cli"
fi

# Check if editorconfig-checker is available
if command -v editorconfig-checker >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running editorconfig-checker..."
  if ! editorconfig-checker; then
    echo "${RED}✗ editorconfig-checker failed${NC}"
    FAILED=1
  fi
else
  echo "${YELLOW}⚠ editorconfig-checker not found, skipping...${NC}"
fi

# Check if shellcheck is available
if command -v shellcheck >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running shellcheck..."
  # Find all shell scripts (including those without .sh extension)
  SHELL_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|bash)$|^scripts/' || true)
  if [ -n "$SHELL_FILES" ]; then
    for file in $SHELL_FILES; do
      if [ -f "$file" ]; then
        if ! shellcheck "$file"; then
          echo "${RED}✗ shellcheck failed for $file${NC}"
          FAILED=1
        fi
      fi
    done
  else
    echo "  No shell scripts to check"
  fi
else
  echo "${YELLOW}⚠ shellcheck not found, skipping...${NC}"
fi

# Check if shfmt is available
if command -v shfmt >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running shfmt..."
  # Find all shell scripts (including those without .sh extension)
  SHELL_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|bash)$|^scripts/' || true)
  if [ -n "$SHELL_FILES" ]; then
    for file in $SHELL_FILES; do
      if [ -f "$file" ]; then
        # Check formatting with default style (-d for diff)
        if ! shfmt -d "$file"; then
          echo "${RED}✗ shfmt failed for $file${NC}"
          echo "  Run: shfmt -w $file"
          FAILED=1
        fi
      fi
    done
  else
    echo "  No shell scripts to check"
  fi
else
  echo "${YELLOW}⚠ shfmt not found, skipping...${NC}"
  echo "  Install with: brew install shfmt"
fi

# Check if helm is available
if command -v helm >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running helm lint..."
  # Find all Helm charts by looking for Chart.yaml files
  CHART_DIRS=$(find apps -name Chart.yaml -exec dirname {} \; 2>/dev/null || true)
  if [ -n "$CHART_DIRS" ]; then
    for chart_dir in $CHART_DIRS; do
      echo "  Linting $chart_dir..."
      if ! helm lint "$chart_dir" --strict; then
        echo "${RED}✗ helm lint failed for $chart_dir${NC}"
        FAILED=1
      fi
    done
  else
    echo "  No Helm charts found"
  fi
else
  echo "${YELLOW}⚠ helm not found, skipping...${NC}"
fi

# Check if kubeconform is available
if command -v kubeconform >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running kubeconform validation..."
  CHART_DIRS=$(find apps -name Chart.yaml -exec dirname {} \; 2>/dev/null || true)
  if [ -n "$CHART_DIRS" ]; then
    for chart_dir in $CHART_DIRS; do
      echo "  Validating $chart_dir..."
      if ! helm template "$chart_dir" | kubeconform -strict -kubernetes-version 1.25.0 -summary -ignore-missing-schemas; then
        echo "${RED}✗ kubeconform validation failed for $chart_dir${NC}"
        FAILED=1
      fi
    done
  fi
else
  echo "${YELLOW}⚠ kubeconform not found, skipping...${NC}"
  echo "  Install with: brew install kubeconform"
fi

# Check if kube-linter is available
if command -v kube-linter >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running kube-linter..."
  CHART_DIRS=$(find apps -name Chart.yaml -exec dirname {} \; 2>/dev/null || true)
  if [ -n "$CHART_DIRS" ]; then
    for chart_dir in $CHART_DIRS; do
      echo "  Linting $chart_dir..."
      if ! helm template "$chart_dir" | kube-linter lint --config .kube-linter.yaml -; then
        echo "${RED}✗ kube-linter failed for $chart_dir${NC}"
        FAILED=1
      fi
    done
  fi
else
  echo "${YELLOW}⚠ kube-linter not found, skipping...${NC}"
  echo "  Install with: brew install kube-linter"
fi

# Check if trivy is available
if command -v trivy >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running trivy security scan..."
  CHART_DIRS=$(find apps -name Chart.yaml -exec dirname {} \; 2>/dev/null || true)
  if [ -n "$CHART_DIRS" ]; then
    for chart_dir in $CHART_DIRS; do
      echo "  Scanning $chart_dir..."
      if ! helm template "$chart_dir" | trivy config --config trivy.yaml --severity CRITICAL,HIGH -; then
        echo "${RED}✗ trivy security scan failed for $chart_dir${NC}"
        FAILED=1
      fi
    done
  fi
else
  echo "${YELLOW}⚠ trivy not found, skipping...${NC}"
  echo "  Install with: brew install trivy"
fi

if [ $FAILED -eq 1 ]; then
  echo ""
  echo "${RED}Pre-commit checks failed. Please fix the errors above.${NC}"
  exit 1
fi

echo ""
echo "${GREEN}✓ All pre-commit checks passed!${NC}"
exit 0
