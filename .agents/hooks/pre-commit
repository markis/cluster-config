#!/bin/sh
set -e

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

FAILED=0

# Check if editorconfig-checker is available
if command -v editorconfig-checker >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running editorconfig-checker..."
  if ! editorconfig-checker; then
    echo "${RED}✗ editorconfig-checker failed${NC}"
    FAILED=1
  fi
else
  echo "${YELLOW}⚠ editorconfig-checker not found, skipping...${NC}"
fi

# Check if shellcheck is available
if command -v shellcheck >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running shellcheck..."
  # Find all shell scripts (including those without .sh extension)
  SHELL_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|bash)$|^scripts/' || true)
  if [ -n "$SHELL_FILES" ]; then
    for file in $SHELL_FILES; do
      if [ -f "$file" ]; then
        if ! shellcheck "$file"; then
          echo "${RED}✗ shellcheck failed for $file${NC}"
          FAILED=1
        fi
      fi
    done
  else
    echo "  No shell scripts to check"
  fi
else
  echo "${YELLOW}⚠ shellcheck not found, skipping...${NC}"
fi

# Check if helm is available
if command -v helm >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running helm lint..."
  # Find all Helm charts by looking for Chart.yaml files
  CHART_DIRS=$(find apps -name Chart.yaml -exec dirname {} \; 2>/dev/null || true)
  if [ -n "$CHART_DIRS" ]; then
    for chart_dir in $CHART_DIRS; do
      echo "  Linting $chart_dir..."
      if ! helm lint "$chart_dir" --strict; then
        echo "${RED}✗ helm lint failed for $chart_dir${NC}"
        FAILED=1
      fi
    done
  else
    echo "  No Helm charts found"
  fi
else
  echo "${YELLOW}⚠ helm not found, skipping...${NC}"
fi

# Check if kubeconform is available
if command -v kubeconform >/dev/null 2>&1; then
  echo "${GREEN}✓${NC} Running kubeconform validation..."
  CHART_DIRS=$(find apps -name Chart.yaml -exec dirname {} \; 2>/dev/null || true)
  if [ -n "$CHART_DIRS" ]; then
    for chart_dir in $CHART_DIRS; do
      echo "  Validating $chart_dir..."
      if ! helm template "$chart_dir" | kubeconform -strict -kubernetes-version 1.25.0 -summary -ignore-missing-schemas; then
        echo "${RED}✗ kubeconform validation failed for $chart_dir${NC}"
        FAILED=1
      fi
    done
  fi
else
  echo "${YELLOW}⚠ kubeconform not found, skipping...${NC}"
  echo "  Install with: brew install kubeconform"
fi

if [ $FAILED -eq 1 ]; then
  echo ""
  echo "${RED}Pre-commit checks failed. Please fix the errors above.${NC}"
  exit 1
fi

echo ""
echo "${GREEN}✓ All pre-commit checks passed!${NC}"
exit 0
